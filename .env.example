# External host port.
HOMEDASH_PORT=3002

# Published image. Use a version tag for predictable Portainer updates.
HOMEDASH_IMAGE=ghcr.io/immer-gut/homedash:v1.8.1

# Internal container port. Usually leave this at 3000.
HOMEDASH_INTERNAL_PORT=3000

# Docker resource names.
HOMEDASH_CONTAINER_NAME=homedash
HOMEDASH_VOLUME_NAME=homedash_data

# Optional admin protection. You can also set this during first-run setup.
# ADMIN_PASSWORD=change-me

# Optional legacy status integrations. New setups can also configure status widgets directly on links in the browser.
# Secrets stored on links are saved in homedash.json; env secrets stay in the container environment.
# HOMEDASH_STATUS_TARGETS=[{"type":"proxmox","name":"PVE","url":"https://192.168.1.15:8006","tokenId":"root@pam!homedash","tokenSecret":"secret"},{"type":"proxmoxbackup","name":"PBS","url":"https://192.168.1.16:8007","tokenId":"root@pam!homedash","tokenSecret":"secret"},{"type":"unraid","name":"Unraid","url":"http://192.168.1.10","apiKey":"secret"},{"type":"amp","name":"AMP","url":"https://amp.example.local","username":"admin","password":"secret"}]
