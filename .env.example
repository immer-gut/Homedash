# External host port.
HOMEBASE_PORT=3000

# Published image. Use a version tag such as ghcr.io/sandavdesigns/homebase:v0.1.0 for pinned releases.
HOMEBASE_IMAGE=ghcr.io/sandavdesigns/homebase:latest

# Internal container port. Usually leave this at 3000.
HOMEBASE_INTERNAL_PORT=3000

# Docker resource names.
HOMEBASE_CONTAINER_NAME=homebase
HOMEBASE_VOLUME_NAME=homebase_data

# Optional admin protection. You can also set this during first-run setup.
# ADMIN_PASSWORD=change-me

# Optional legacy status integrations. New setups can also configure status widgets directly on links in the browser.
# Secrets stored on links are saved in homebase.json; env secrets stay in the container environment.
# HOMEBASE_STATUS_TARGETS=[{"type":"proxmox","name":"PVE","url":"https://192.168.1.15:8006","tokenId":"root@pam!homebase","tokenSecret":"secret"},{"type":"unraid","name":"Unraid","url":"http://192.168.1.10","apiKey":"secret"},{"type":"amp","name":"AMP","url":"https://amp.example.local","username":"admin","password":"secret"}]
